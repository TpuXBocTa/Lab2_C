/* USER CODE BEGIN Includes */
#include "stm32f4xx_hal.h"
/* USER CODE END Includes */

/* USER CODE BEGIN PV */
volatile uint8_t mode = 0;  // 0..3 – режими гірлянди
/* USER CODE END PV */

/* USER CODE BEGIN PFP */
void LED_Init(void);
void Button_Init(void);

void mode0_wave(void);
void mode1_blink_all(void);
void mode2_knight_rider(void);
void mode3_binary_counter(void);
/* USER CODE END PFP */

/* USER CODE BEGIN 0 */

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == GPIO_PIN_0)
    {
        mode++;
        if (mode > 3)
            mode = 0;
    }
}

/* USER CODE END 0 */

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  LED_Init();
  Button_Init();

  while (1)
  {
      switch (mode)
      {
          case 0: mode0_wave(); break;
          case 1: mode1_blink_all(); break;
          case 2: mode2_knight_rider(); break;
          case 3: mode3_binary_counter(); break;
      }
  }
}

/* ---------------------------------------------------------
   ІНІЦІАЛІЗАЦІЯ LED (PD12 – PD15)
--------------------------------------------------------- */
void LED_Init(void)
{
    __HAL_RCC_GPIOD_CLK_ENABLE();

    GPIO_InitTypeDef gpio = {0};
    gpio.Pin = GPIO_PIN_12 | GPIO_PIN_13 | GPIO_PIN_14 | GPIO_PIN_15;
    gpio.Mode = GPIO_MODE_OUTPUT_PP;
    gpio.Pull = GPIO_NOPULL;
    gpio.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOD, &gpio);
}

/* ---------------------------------------------------------
   ІНІЦІАЛІЗАЦІЯ КНОПКИ (PA0-WKUP із EXTI0)
--------------------------------------------------------- */
void Button_Init(void)
{
    __HAL_RCC_GPIOA_CLK_ENABLE();

    GPIO_InitTypeDef btn = {0};
    btn.Pin = GPIO_PIN_0;
    btn.Mode = GPIO_MODE_IT_FALLING;     // кнопка на замикання на GND
    btn.Pull = GPIO_PULLUP;
    HAL_GPIO_Init(GPIOA, &btn);

    HAL_NVIC_SetPriority(EXTI0_IRQn, 0, 0);
    HAL_NVIC_EnableIRQ(EXTI0_IRQn);
}

/* ---------------------------------------------------------
   РЕЖИМИ БЛИМАННЯ
--------------------------------------------------------- */

/* Режим 0: хвиля → PD12 → PD13 → PD14 → PD15 */
void mode0_wave(void)
{
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_All, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_SET);
    HAL_Delay(100);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, GPIO_PIN_SET);
    HAL_Delay(100);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_14, GPIO_PIN_SET);
    HAL_Delay(100);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_14, GPIO_PIN_RESET);

    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_15, GPIO_PIN_SET);
    HAL_Delay(100);
}

/* Режим 1: всі блимають одночасно */
void mode1_blink_all(void)
{
    HAL_GPIO_TogglePin(GPIOD, GPIO_PIN_12 | GPIO_PIN_13 | GPIO_PIN_14 | GPIO_PIN_15);
    HAL_Delay(250);
}

/* Режим 2: Knight Rider (вперед–назад) */
void mode2_knight_rider(void)
{
    static int pos = 0;
    static int dir = 1;

    uint16_t leds[4] = {GPIO_PIN_12, GPIO_PIN_13, GPIO_PIN_14, GPIO_PIN_15};

    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_All, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, leds[pos], GPIO_PIN_SET);

    pos += dir;
    if (pos == 3 || pos == 0)
        dir = -dir;

    HAL_Delay(100);
}

/* Режим 3: бінарний лічильник 0 → 15 */
void mode3_binary_counter(void)
{
    static uint8_t counter = 0;

    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, (counter & 1) ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, (counter & 2) ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_14, (counter & 4) ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_15, (counter & 8) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    counter++;
    HAL_Delay(150);
}

/* ---------------------------------------------------------
   EXTI IRQ Handler
--------------------------------------------------------- */
void EXTI0_IRQHandler(void)
{
    HAL_GPIO_EXTI_IRQHandler(GPIO_PIN_0);
}

