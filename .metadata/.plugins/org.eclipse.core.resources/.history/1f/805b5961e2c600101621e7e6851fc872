#include "main.h"

/* Private variables ---------------------------------------------------------*/
uint8_t mode = 0;           // поточний режим
uint8_t button_last = 0;    // попередній стан кнопки
uint32_t last_debounce = 0; // захист від дребезгу

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);

void set_leds(uint8_t d12, uint8_t d13, uint8_t d14, uint8_t d15)
{
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, d12 ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, d13 ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_14, d14 ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOD, GPIO_PIN_15, d15 ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    uint32_t lastBlink = 0;
    uint8_t step = 0;

    while (1)
    {
        /* ----------------------- BUTTON HANDLING ------------------------ */
        uint8_t button_now = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);

        if (button_now != button_last)
        {
            last_debounce = HAL_GetTick();
            button_last = button_now;
        }

        if ((HAL_GetTick() - last_debounce) > 50)
        {
            // реагуємо на НАТИСКАННЯ (edge: 0 → 1)
            if (button_now == 1)
            {
                mode = (mode + 1) % 3; // всього 3 режими
            }
        }

        /* -------------------------- BLINKING ---------------------------- */
        if (HAL_GetTick() - lastBlink > 200)
        {
            lastBlink = HAL_GetTick();

            switch(mode)
            {
                case 0: // РЕЖИМ 1 — по колу
                    if(step == 0) set_leds(1,0,0,0);
                    if(step == 1) set_leds(0,1,0,0);
                    if(step == 2) set_leds(0,0,1,0);
                    if(step == 3) set_leds(0,0,0,1);
                    step = (step + 1) % 4;
                    break;

                case 1: // РЕЖИМ 2 — всі разом
                    set_leds(step, step, step, step);
                    step = !step;
                    break;

                case 2: // РЕЖИМ 3 — альтернативно
                    if(step == 0) set_leds(1,0,1,0);
                    if(step == 1) set_leds(0,1,0,1);
                    step = !step;
                    break;
            }
        }
    }
}

