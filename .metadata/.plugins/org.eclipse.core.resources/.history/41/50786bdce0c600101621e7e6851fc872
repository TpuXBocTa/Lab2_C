/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* MCU Configuration--------------------------------------------------------*/

  HAL_Init();

  SystemClock_Config();

  LED_Init();
  Button_Init();

  while (1)
  {
      switch (mode)
      {
          case 0: mode0_wave(); break;
          case 1: mode1_blink_all(); break;
          case 2: mode2_knight_rider(); break;
          case 3: mode3_binary_counter(); break;
      }
  }
}

